# Copy to .env.local for local runs. Never commit real secrets.

# --- Telegram alert (GitHub Action / optional API route) ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs, e.g. 111,222,333 (up to ~10 recipients)
TELEGRAM_CHAT_IDS=

# --- Optional API route (Vercel Cron path) ---
# Protects GET /api/cron/check-alerts (sent as: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# --- Web app ---
# Raw URL of your committed data/history.json so the deployed app shows fresh
# data without redeploying. If unset, falls back to the file committed at build time.
# https://raw.githubusercontent.com/<user>/<repo>/main/data/history.json
HISTORY_JSON_URL=
